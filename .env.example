# EAOC Environment Configuration Placeholder
# Copy this file to .env for local development

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Primary Database Settings: Supabase PostgreSQL (postgresql+asyncpg://...)
# Note: Supabase is the EXCLUSIVE primary database for EAOC.
# Option A (Supabase Direct Connection):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres
# Option B (Supabase Connection Pooler):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-SUPABASE-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Additional Settings (Optional)
SUPABASE_URL=https://[YOUR-SUPABASE-REF].supabase.co
SUPABASE_ANON_KEY=change_this_in_local_env

# Redis Settings (Future Component)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Local LLM Serving Runtime (Ollama / LM Studio - Model Agnostic)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=nomic-embed-text
DEFAULT_LLM_MODEL=llama3.2:3b
REASONING_LLM_MODEL=qwen2.5:7b

# Security & Secret Keys (DO NOT COMMIT REAL SECRETS)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
