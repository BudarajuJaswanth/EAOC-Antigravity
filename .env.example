# EAOC Environment Configuration Template (.env.example)
# Copy this file to '.env' for local development. Never commit real credentials.

# ==============================================================================
# 1. APPLICATION & ENVIRONMENT SETTINGS (Required)
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==============================================================================
# 2. PRIMARY DATABASE: SUPABASE POSTGRESQL (Required for DB features)
# Supabase PostgreSQL is the EXCLUSIVE primary database platform.
# Driver must be postgresql+asyncpg://
# ==============================================================================
# Option A (Direct Connection):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres
# Option B (Connection Pooler):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-SUPABASE-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:Jayaram%409384@db.albvbjjtlwtnhjfqlwlb.supabase.co:5432/postgres

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

SUPABASE_URL=https://[YOUR-SUPABASE-REF].supabase.co
SUPABASE_ANON_KEY=change_this_in_local_env

# ==============================================================================
# 3. REDIS SETTINGS (Runtime State Persistence Layer)
# ==============================================================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# ==============================================================================
# 4. MODEL PROVIDER SETTINGS (Model-Agnostic Abstraction)
# Selected provider choice: gemini, lm_studio, or ollama
# ==============================================================================
DEFAULT_MODEL_PROVIDER=gemini

# Local Provider 1: LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Local Provider 2: Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ==============================================================================
# 5. SECURITY & AUTHENTICATION PLACEHOLDERS (Future Component)
# ==============================================================================
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
